# ========================
# Server Configuration
# ========================
PORT=3000
HOST=0.0.0.0


# ========================
# Provider URL Configuration
# ========================
ANIKOTOURL="https://anikototv.to"
ANIZONEURL='https://anizone.to'


# ========================
# Rate Limiting
# ========================
# Maximum API requests allowed per minute
MAX_API_REQUESTS=120
# Duration (in minutes) to track requests
WINDOW_IN_MINUTES=1

# ========================
# Redis Configuration (Upstash Recommended)
# ========================
REDIS_PORT=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_NAMESPACE=kenjitsu

# ========================
# CORS Configuration
# ========================
# Allowed origins 
ALLOWED_ORIGINS='*'
# Wildcard is safe only while credentials are disabled.
CORS_CREDENTIALS=false

# ========================
# Vercel Deployment
# ========================
VERCEL_FORCE_NO_BUILD_CACHE=1
